aws_region    = "ap-south-1"
instance_type = "t4g.micro"
root_volume_gb = 20

# Replace with your office/home IP before apply.
ssh_cidr = "203.0.113.10/32"

# Optional: EC2 key pair name in ap-south-1 for SSH.
# ssh_key_name = "complibot-demo"

# DNS name for HTTPS (A record → terraform output public_ip). Serves API + Next.js on one origin.
api_domain = "api.demo.example.com"
acme_email = "you@example.com"

# https://<api_domain> is always allowed (UI is served from the same host). Add extra origins only if needed.
# cors_allowed_origins = ["https://your-vercel-app.vercel.app"]

# Public demo: allow passwordless dev login (any email). Default false for locked-down hosts.
# dev_login_enabled = true

# Worker LLM (inject OPENROUTER_API_KEY on the instance .env; not in Terraform).
# llm_provider = "openrouter"
# openrouter_model = "nvidia/nemotron-3-ultra-550b-a55b:free"
