APP_ENV=local
DEV_LOGIN_ENABLED=true
# Postgres (make up) or SQLite for quick local dev without Docker:
DATABASE_URL=sqlite+aiosqlite:///./.data/complibot.db
# DATABASE_URL=postgresql+asyncpg://complibot:complibot@localhost:5432/complibot
INLINE_WORKER=true
SCHEMA_AUTO_CREATE=true
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=complibot-demo
SQS_QUEUE_URL=http://localhost:4566/000000000000/complibot-review
JWT_ISSUER=http://localhost:8080/mock-issuer
JWT_AUDIENCE=complibot-local
DEV_AUTH_SECRET=dev-only-change-me
# Required when LLM_PROVIDER=openrouter locally (never commit a real key).
# EC2 demo: OPENROUTER_API_KEY is injected at boot from Secrets Manager
# secret complibot-demo/openrouter-api-key (set the value once in the AWS console).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_MAX_TOKENS=8000
OPENROUTER_TIMEOUT_SECONDS=120
LLM_PROVIDER=mock
# LLM_PROVIDER=bedrock
# LLM_PROVIDER=openrouter
# BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
# BEDROCK_REGION=ap-south-1
# LLM_BEDROCK_FALLBACK_MOCK=false
CORS_ORIGINS=http://localhost:3000

# --- Production (EC2 + docker-compose.prod.yml) ---
# Copy this block into .env on the instance; keep local values above for `make api` + LocalStack.
# APP_ENV=demo
# DEV_LOGIN_ENABLED=false   # true is the only way to sign in to this demo (no Cognito); see runbook
# POSTGRES_PASSWORD=change-me-strong   # URL-safe chars only; it is embedded in DATABASE_URL
# DATABASE_URL is set by docker-compose.prod.yml (postgres service); do not point at localhost.
# INLINE_WORKER=false
# SCHEMA_AUTO_CREATE=true
# API_DOMAIN=api.demo.example.com   # public hostname (also baked into web as NEXT_PUBLIC_API_URL at image build)
# ACME_EMAIL=you@example.com
# AWS_REGION=ap-south-1
# AWS_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET=complibot-demo-documents-ACCOUNT_ID
# BACKUP_S3_BUCKET=complibot-demo-backups-ACCOUNT_ID
# SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/ACCOUNT_ID/complibot-demo-review
# JWT_ISSUER=https://demo.complibot.example/auth
# JWT_AUDIENCE=complibot-demo
# DEV_AUTH_SECRET=generate-at-least-32-random-characters   # required outside local (signs all JWTs)
# LLM_PROVIDER=mock
# LLM_PROVIDER=bedrock
# LLM_PROVIDER=openrouter
# Demo EC2: user-data loads OPENROUTER_API_KEY from Secrets Manager (complibot-demo/openrouter-api-key).
# Set the secret value in the AWS console; it is not stored in Terraform state or tfvars.
# BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# BEDROCK_REGION=ap-south-1
# CORS_ORIGINS=https://api.demo.example.com   # same origin as API_DOMAIN when UI is on EC2
# BACKUP_S3_PREFIX=db
